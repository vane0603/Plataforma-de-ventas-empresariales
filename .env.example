# =====================================================================
# Copie este archivo como .env y complete los valores.
# NUNCA suba el .env al repositorio (ya está en .gitignore).
# =====================================================================

# --- General ---------------------------------------------------------
DEBUG=1
DJANGO_SECRET_KEY=cambie-esta-clave-larga-y-aleatoria
ALLOWED_HOSTS=127.0.0.1,localhost
PUBLIC_BASE_URL=http://127.0.0.1:8000
# Solo producción (HTTPS): https://midominio.com,https://www.midominio.com
CSRF_TRUSTED_ORIGINS=
APP_LOG_LEVEL=INFO

# --- Base de datos (DB_NAME vacío = SQLite) ---------------------------
# MySQL:      DB_ENGINE=django.db.backends.mysql       DB_PORT=3306
# PostgreSQL: DB_ENGINE=django.db.backends.postgresql  DB_PORT=5432
DB_ENGINE=django.db.backends.mysql
DB_NAME=
DB_USER=
DB_PASSWORD=
DB_HOST=localhost
DB_PORT=3306

# --- Correo (sin usuario/clave los correos salen por consola) --------
EMAIL_HOST=smtp.office365.com
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=

# --- Protección de datos (Ley 1581 de 2012) --------------------------
# Generar con: python manage.py generar_clave_cifrado
# ¡Guárdelas en un lugar seguro! Sin DATOS_CIFRADO_CLAVES no se pueden leer
# los documentos y teléfonos guardados.
DATOS_CIFRADO_CLAVES=
DATOS_HUELLA_CLAVE=
RETENCION_DATOS_DIAS=730
POLITICA_DATOS_VERSION=2026-10
RESPONSABLE_RAZON_SOCIAL=
RESPONSABLE_NIT=
RESPONSABLE_DIRECCION=
RESPONSABLE_CIUDAD=Bogotá D.C.
RESPONSABLE_CORREO_DATOS=
RESPONSABLE_TELEFONO=

# --- Pasarela de pagos (Wompi) ---------------------------------------
# Pruebas: pub_test_ / test_integrity_ / test_events_ y la URL sandbox.
PASARELA_PAGOS=wompi
WOMPI_PUBLIC_KEY=
WOMPI_INTEGRITY_SECRET=
WOMPI_EVENTS_SECRET=
WOMPI_API_URL=https://sandbox.wompi.co/v1
# Producción: WOMPI_API_URL=https://production.wompi.co/v1

# --- Fondos de empleados (verificación por API) ----------------------
FONDOS_API_TIMEOUT=8
# El token de cada fondo va en una variable cuyo NOMBRE se configura en el admin:
# FONDO_EJEMPLO_TOKEN=

# --- API REST (límites por minuto) -----------------------------------
API_LIMITE_ANONIMO=120/min
API_LIMITE_USUARIO=600/min
